generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  KASIR
  GUDANG
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum TransactionStatus {
  COMPLETED
  VOID
}

enum PriceTier {
  RETAIL
  WHOLESALE
}

enum StockLogType {
  IN
  OUT
}

model User {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(255)
  password     String
  role         Role
  failedLogins Int           @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  stockLogs    StockLog[]
}

model Product {
  id               String            @id @default(cuid())
  barcode          String            @unique @db.VarChar(50)
  name             String            @db.VarChar(255)
  category         String            @db.VarChar(100)
  purchasePrice    Decimal           @db.Decimal(12, 2)
  retailPrice      Decimal           @db.Decimal(12, 2)
  wholesalePrice   Decimal?          @db.Decimal(12, 2)
  wholesaleMinQty  Int               @default(12)
  stock            Int               @default(0)
  minStock         Int               @default(10)
  unit             String            @default("pcs") @db.VarChar(20)
  supplierId       String?
  isActive         Boolean           @default(true)
  imageUrl         String?           @db.VarChar(500)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  transactionItems TransactionItem[]
  stockLogs        StockLog[]

  @@index([category])
  @@index([supplierId])
  @@index([isActive, name])
}

model Transaction {
  id            String            @id @default(cuid())
  invoiceNumber String            @unique @db.VarChar(20)
  totalAmount   Decimal           @db.Decimal(14, 2)
  totalItems    Int
  totalProfit   Decimal           @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  amountPaid    Decimal           @db.Decimal(14, 2)
  changeAmount  Decimal           @default(0) @db.Decimal(14, 2)
  customerPhone String?           @db.VarChar(20)
  customerName  String?           @db.VarChar(100)
  status        TransactionStatus @default(COMPLETED)
  cashierId     String
  notes         String?           @db.VarChar(500)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  cashier       User              @relation(fields: [cashierId], references: [id])
  items         TransactionItem[]

  @@index([cashierId])
  @@index([paymentMethod])
  @@index([status, createdAt])
  @@index([createdAt])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  productId     String
  quantity      Int
  unitPrice     Decimal     @db.Decimal(12, 2)
  totalPrice    Decimal     @db.Decimal(14, 2)
  purchasePrice Decimal     @db.Decimal(12, 2)
  profit        Decimal     @db.Decimal(14, 2)
  priceTier     PriceTier
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@index([productId])
  @@index([transactionId, productId])
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(255)
  phone     String?   @db.VarChar(20)
  address   String?   @db.VarChar(500)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model StockLog {
  id        String       @id @default(cuid())
  productId String
  type      StockLogType
  quantity  Int
  reference String       @db.VarChar(255)
  userId    String
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}
